# Copiare questo file in .env solo per personalizzare i valori locali.
POSTGRES_DB=liveauction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

PRODUCER_PORT=8081
CONSUMER_PORT=8082

# Per il profilo prod: impostare una stringa casuale di almeno 32 byte.
AUTH_JWT_SECRET=

# Opzionali, ad esempio: -Xms128m -Xmx512m
PRODUCER_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
CONSUMER_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
