    {
      "name": "05 • Login USER demo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "description": "Usa alice_demo e la password demo per ottenere userToken.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Ruolo USER e token', () => {",
              "    pm.expect(data.ruolo).to.eql('USER');",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.environment.set('userToken', data.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
