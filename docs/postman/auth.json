{
  "info": {
    "name": "LiveAuction • Auth",
    "_postman_id": "6b2d2d03-6a55-4f7f-ba3c-4a381cf72589",
    "description": "Endpoint auth del Producer. Registrare un USER per popolare le variabili; i login per utenti esistenti richiedono credenziali impostate nell'ambiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 • Registra nuovo USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "description": "Crea utente e portafoglio a zero. Rieseguibile: il pre-request genera credenziali nuove.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.environment.set('newUsername', 'postman_' + suffix);",
              "pm.environment.set('newEmail', 'postman_' + suffix + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.test('USER senza password nella risposta', () => {",
              "    pm.expect(data.ruolo).to.eql('USER');",
              "    pm.expect(data.id).to.be.a('number');",
              "    pm.expect(data).not.to.have.property('password');",
              "    pm.expect(data).not.to.have.property('passwordHash');",
              "  });",
              "  pm.environment.set('newUserId', String(data.id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 • Login nuovo USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "description": "Verifica le credenziali appena registrate e salva userToken.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Token Bearer presente', () => {",
              "    pm.expect(data.tokenType).to.eql('Bearer');",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.environment.set('userToken', data.accessToken);",
              "  pm.environment.set('userRefreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 • Registrazione duplicata → 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "description": "Usa le stesse credenziali della richiesta 01.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 • Registrazione non valida → 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "description": "Verifica la validazione della richiesta.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"x\",\n  \"email\": \"non-una-email\",\n  \"password\": \"breve\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 • Login USER esistente (facoltativo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "description": "Imposta userUsername e userPassword nell'ambiente per ottenere userToken.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Ruolo USER e token', () => {",
              "    pm.expect(data.ruolo).to.eql('USER');",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.environment.set('userToken', data.accessToken);",
              "  pm.environment.set('userRefreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 • Login ADMIN esistente (facoltativo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "description": "Imposta adminUsername e adminPassword nell'ambiente dopo aver creato un ADMIN nel database.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Ruolo ADMIN e token', () => {",
              "    pm.expect(data.ruolo).to.eql('ADMIN');",
              "    pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
              "  });",
              "  pm.environment.set('adminToken', data.accessToken);",
              "  pm.environment.set('adminRefreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 • Password errata → 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "description": "Le credenziali errate non rilasciano token.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"password\": \"password-errata\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 • Refresh USER",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/refresh",
        "auth": { "type": "noauth" },
        "description": "Rinnova l'access token e sostituisce il refresh token; eseguire dopo un login USER.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) {",
            "  const data = pm.response.json();",
            "  pm.test('Nuovi token presenti', () => { pm.expect(data.accessToken).to.be.a('string').and.not.empty; pm.expect(data.refreshToken).to.be.a('string').and.not.empty; });",
            "  pm.environment.set('userToken', data.accessToken);",
            "  pm.environment.set('userRefreshToken', data.refreshToken);",
            "}"
          ]
        }
      }]
    },
    {
      "name": "09 • Logout USER",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/auth/logout",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "description": "Revoca la sessione corrente; eseguire per ultimo."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));",
            "if (pm.response.code === 204) { pm.environment.unset('userToken'); pm.environment.unset('userRefreshToken'); }"
          ]
        }
      }]
    },
    {
      "name": "10 • Elimina il proprio account (facoltativo)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/me",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "description": "Operazione permanente: disattiva e anonimizza l'account, revocando tutte le sessioni. Eseguire manualmente dopo un nuovo login USER."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));",
            "if (pm.response.code === 204) { pm.environment.unset('userToken'); pm.environment.unset('userRefreshToken'); }"
          ]
        }
      }]
    }
  ]
}
